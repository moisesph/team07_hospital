generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TimeSlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model Doctor {
  id         String     @id
  name       String
  specialty  String
  hospitalId String
  timeSlots  TimeSlot[]

  @@map("doctors")
}

model TimeSlot {
  id              String         @id @default(uuid())
  doctorId        String
  doctor          Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startsAt        DateTime       @db.Timestamptz(6)
  durationMinutes Int            @default(90)
  status          TimeSlotStatus @default(AVAILABLE)
  booking         Booking?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([doctorId, startsAt])
  @@index([doctorId, startsAt])
  @@map("time_slots")
}

model Booking {
  id         String        @id @default(uuid())
  timeSlotId String        @unique
  timeSlot   TimeSlot      @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  patientId  String?
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now())

  @@map("bookings")
}
