# Pooled Neon connection used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-name-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct Neon connection used by Prisma CLI commands and the seed script.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-name.region.aws.neon.tech/dbname?sslmode=require"

# Set to 1 to force local fixture data even when a database URL is present.
USE_MOCK_AVAILABILITY=0
